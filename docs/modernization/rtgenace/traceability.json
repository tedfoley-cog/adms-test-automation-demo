  "history": [
    {
      "id": "D1",
      "kind": "pre-port divergence",
      "summary": "agc.py clamped max first, min second; ALLOCR clamps min first, max second. When min > max the setpoint was off by 20 MW.",
      "resolution": "Clamp order aligned to ALLOCR.",
      "commit": "e635902f2734269c222b103cab26f224e80231d8"
    },
    {
      "id": "D2",
      "kind": "pre-port divergence",
      "summary": "savecase.py kept reading records after END.",
      "resolution": "Reader stops at END.",
      "commit": "e635902f2734269c222b103cab26f224e80231d8"
    },
    {
      "id": "D3",
      "kind": "pre-port divergence",
      "summary": "savecase.py accepted more than MAXTIE/MAXUNT records, which the legacy refuses with IERR=2.",
      "resolution": "Table capacities enforced; overflow raises SavecaseError(2).",
      "commit": "e635902f2734269c222b103cab26f224e80231d8"
    },
    {
      "id": "D4",
      "kind": "pre-port divergence",
      "summary": "7 corpus cases differed only by float32 rounding, which the fixed 0.01 MW tolerance rejected.",
      "resolution": "Fixed tolerance replaced by ace_parity_bound / setpoint_parity_bound.",
      "commit": "e635902f2734269c222b103cab26f224e80231d8"
    },
    {
      "id": "D5",
      "kind": "pre-port divergence",
      "summary": "One knife-edge case where float32 put the legacy ACE on the other side of the 5 MW deadband.",
      "resolution": "deadband_indeterminate rule (RTG-P02).",
      "commit": "e635902f2734269c222b103cab26f224e80231d8"
    },
    {
      "id": "F01",
      "kind": "review finding",
      "summary": "Duplicate unit names collapsed to one setpoint (dict keyed by name).",
      "resolution": "fixed: allocate_regulation_by_unit returns one setpoint per row.",
      "commit": "1f71151d8d8ca65fdbc08dda7314d28a075a48c7"
    },
    {
      "id": "F02",
      "kind": "review finding",
      "summary": "Inventory counted collected characterization tests, so failing ones still showed 'verified'.",
      "resolution": "fixed: inventory runs the suite and counts passing tests only.",
      "commit": "1f71151d8d8ca65fdbc08dda7314d28a075a48c7"
